rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signedIn() { return request.auth != null; }
  function image() { return request.resource.size <= 2 * 1024 * 1024 && request.resource.contentType in ['image/jpeg','image/png','image/webp']; }
  match /covers/{uid}/{imageId} {
   allow read: if signedIn();
   allow create: if signedIn() && request.auth.uid == uid && imageId.matches('[a-f0-9-]{36}') && image();
   allow update, delete: if false;
  }
  match /reviews/{uid}/{imageId} {
   allow read: if signedIn() && request.auth.uid == uid;
   allow create: if signedIn() && request.auth.uid == uid && imageId.matches('[a-f0-9-]{36}') && image();
   allow update, delete: if false;
  }
  match /profiles/{uid}/{imageId} {
   allow read: if signedIn();
   allow create: if signedIn() && request.auth.uid == uid && imageId.matches('[a-f0-9-]{36}') && image();
   allow update, delete: if false;
  }
  match /{allPaths=**} { allow read,write: if false; }
 }
}
