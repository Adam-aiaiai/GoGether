rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function organizer(eventId) {
      return signedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
    }
    function participant(eventId) {
      return signedIn() && get(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid)).data.status in ['CONFIRMED', 'WAITLISTED'];
    }
    match /events/{id} { allow read: if signedIn(); allow write: if false; }
    match /registrations/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || organizer(resource.data.eventId));
      allow write: if false;
    }
    match /announcements/{id} {
      allow read: if organizer(resource.data.eventId) || participant(resource.data.eventId);
      allow write: if false;
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        request.resource.data.isRead == true;
      allow create, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
