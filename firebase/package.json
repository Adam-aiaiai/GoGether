{
  "private": true,
  "scripts": {
    "start": "powershell -NoProfile -File start-local.ps1",
    "test": "firebase emulators:exec --project demo-gogether --only auth,firestore,functions,storage \"node --test --test-concurrency=1 backend.integration.test.cjs\"",
    "test:unit": "npm --prefix functions test",
    "test:backend:running": "node --test --test-concurrency=1 backend.integration.test.cjs",
    "test:legacy": "firebase emulators:exec --project demo-gogether --only firestore \"node --test coordination.integration.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0"
  }
}
