<resources>
    <style name="Theme.Gogether" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:calendarViewStyle">@style/Widget.Gogether.CalendarView</item>
    </style>
    <style name="Theme.Gogether.Picker" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#F45B2B</item>
        <item name="android:calendarViewStyle">@style/Widget.Gogether.CalendarView</item>
    </style>
    <style name="Theme.Gogether.DatePicker" parent="Theme.Gogether.Picker">
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.Gogether.DatePicker.Confirm</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.Gogether.DatePicker.Cancel</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/Widget.Gogether.DatePicker.Confirm</item>
    </style>
    <style name="Theme.Gogether.TimePicker" parent="Theme.Gogether.Picker">
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.Gogether.DatePicker.Confirm</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.Gogether.DatePicker.Cancel</item>
    </style>
    <style name="Widget.Gogether.DatePicker.Action" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">108dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Gogether.DatePicker.Confirm" parent="Widget.Gogether.DatePicker.Action">
        <item name="android:background">@drawable/calendar_confirm_button</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="Widget.Gogether.DatePicker.Cancel" parent="Widget.Gogether.DatePicker.Action">
        <item name="android:background">@drawable/calendar_cancel_button</item>
        <item name="android:textColor">#F45B2B</item>
    </style>
    <style name="Widget.Gogether.CalendarView" parent="android:style/Widget.Material.Light.CalendarView">
        <!-- The native month/year heading has no public appearance attribute. Keep this
             framework override localized here and recheck it when upgrading the Android SDK. -->
        <item name="*android:monthTextAppearance">@style/TextAppearance.Gogether.CalendarMonth</item>
        <item name="android:dateTextAppearance">@style/TextAppearance.Gogether.CalendarDay</item>
        <item name="android:weekDayTextAppearance">@style/TextAppearance.Gogether.CalendarWeekday</item>
    </style>
    <style name="TextAppearance.Gogether.CalendarMonth" parent="android:style/TextAppearance.Material.Body2">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Gogether.CalendarDay" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/calendar_day_text</item>
    </style>
    <style name="TextAppearance.Gogether.CalendarWeekday" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:textSize">14sp</item>
    </style>
</resources>
